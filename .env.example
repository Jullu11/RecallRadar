# Gemini image extraction
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Amazon.com price checks (Keepa API; requires an active Keepa API plan)
KEEPA_API_KEY=

# Supabase persistence (optional in demo mode — leave blank to use in-memory storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Browser Supabase Auth uses the public anon/publishable key (never the service role)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Spectrum Cloud / Photon iMessage
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Optional comma-separated trusted sender IDs for existing/beta users. New users can link with LINK <10-digit code>.
ALLOWED_SENDER_IDS=

# Shared secret between the Node Spectrum gateway and FastAPI backend
BACKEND_INTERNAL_TOKEN=
BACKEND_URL=http://127.0.0.1:8000

# Local HTTPS tunnel URL registered as the Spectrum webhook target
PUBLIC_BASE_URL=

# Demo helpers: in-memory persistence + CPSC historical-fixture fallback when the live API fails
DEMO_MODE=true
CPSC_FIXTURE_FALLBACK=true
