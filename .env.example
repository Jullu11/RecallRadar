# Gemini image extraction
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Supabase persistence
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Spectrum Cloud / Photon iMessage
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Comma-separated exact Spectrum sender IDs allowed to use the demo. Empty denies everyone.
ALLOWED_SENDER_IDS=

# Shared secret between the Node Spectrum gateway and FastAPI backend
BACKEND_INTERNAL_TOKEN=
BACKEND_URL=http://127.0.0.1:8000

# Local HTTPS tunnel URL registered as the Spectrum webhook target
PUBLIC_BASE_URL=
