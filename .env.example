# Gemini image extraction
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase persistence (system of record). Leave blank + DEMO_MODE=true for in-memory demos.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Spectrum Cloud / Photon iMessage
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Comma-separated exact Spectrum sender IDs allowed to use the demo.
# Use * to allow anyone. Empty denies everyone (gateway will not start).
ALLOWED_SENDER_IDS=

# Shared secret between the Node Spectrum gateway and FastAPI backend
BACKEND_INTERNAL_TOKEN=
BACKEND_URL=http://127.0.0.1:8000

# Local HTTPS tunnel URL registered as the Spectrum webhook target (gateway)
PUBLIC_BASE_URL=

# Public URL for the evidence desk website (Vercel or tunnel).
# Used in iMessage DESK links. Example: https://lodestone.vercel.app
PUBLIC_WEB_URL=http://127.0.0.1:8000

# Extra CORS origins for the API (comma-separated). Vercel *.vercel.app is already allowed.
CORS_ORIGINS=

# In-memory persistence when true (or when Supabase is unset)
DEMO_MODE=true
CPSC_FIXTURE_FALLBACK=true

# Optional Snowflake analytics warehouse (async copy + Purchase Insights / Cortex)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=
SNOWFLAKE_USE_CORTEX=true
SNOWFLAKE_CORTEX_MODEL=llama3.1-8b
